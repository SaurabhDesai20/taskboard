# Copy to .env at the repo root (scripts\setup.ps1 does this for you). Never commit .env.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard
# Host port. 5432 is usually taken by a locally installed Postgres, so TaskBoard uses 35432.
POSTGRES_PORT=35432

# --- Backend (backend/app/core/config.py) ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://taskboard:taskboard@127.0.0.1:35432/taskboard
# pytest creates and resets this separate database. Its name must end with _test.
TEST_DATABASE_URL=postgresql+psycopg://taskboard:taskboard@127.0.0.1:35432/taskboard_test

# --- Auth (used from Phase 1) ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# --- Hardening (Phase 7) ---
# Requests per client IP per minute to each auth endpoint (login, register); 0 turns it off.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Login attempts per client IP and email per minute; 0 turns it off.
AUTH_RATE_LIMIT_PER_EMAIL_PER_MINUTE=10
# The built UI that FastAPI serves, relative to the repo root (scripts\build.ps1 creates it).
FRONTEND_DIST_DIR=frontend/dist
